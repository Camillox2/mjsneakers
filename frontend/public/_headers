# Cabeçalhos da hospedagem (Cloudflare Pages ou Netlify).
# A CSP abaixo é trocada no build (vite.config.js) pela política completa, com a
# origem da API do VITE_API_URL e frame-ancestors 'none'.

/*
  Content-Security-Policy: __PZ_CSP__
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
